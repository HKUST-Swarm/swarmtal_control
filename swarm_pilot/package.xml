<?xml version="1.0"?>
<package format="2">
  <name>swarm_pilot</name>
  <version>0.0.1</version>
  <description>A ROS2 package for swarm pilot control.</description>

  <maintainer email="xuhao3e8@gmail.com">xuhao3e8</maintainer>
  <license>MIT</license>

  <!-- 依赖关系 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 编译依赖 -->
  <build_depend>rclcpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>swarm_msgs</build_depend>
  <build_depend>swarmcomm_msgs</build_depend>
  <build_depend>swarmtal_msgs</build_depend>
  <build_depend>bspline</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>eigen3_cmake_module</build_depend>

  <!-- 运行时依赖 -->
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>swarm_msgs</exec_depend>
  <exec_depend>swarmcomm_msgs</exec_depend>
  <exec_depend>swarmtal_msgs</exec_depend>
  <exec_depend>bspline</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
